[
  {
    "start": 0.0,
    "end": 21.12,
    "text": "Welcome back."
  },
  {
    "start": 24.24,
    "end": 27.28,
    "text": "Tonight is an invitation to ground."
  },
  {
    "start": 30.0,
    "end": 37.44,
    "text": "To feel the quiet strength beneath you."
  },
  {
    "start": 37.44,
    "end": 44.24,
    "text": "And let your body settle."
  },
  {
    "start": 44.24,
    "end": 54.24,
    "text": "Let yourself get comfortable."
  },
  {
    "start": 54.24,
    "end": 61.68,
    "text": "There is nothing you need to do."
  },
  {
    "start": 61.68,
    "end": 69.12,
    "text": "Just arrive."
  },
  {
    "start": 69.12,
    "end": 81.12,
    "text": "Take a slow breath in through your nose."
  },
  {
    "start": 81.12,
    "end": 88.56,
    "text": "And gently exhale through your mouth."
  },
  {
    "start": 88.56,
    "end": 96.0,
    "text": "Once more, inhale."
  },
  {
    "start": 96.0,
    "end": 103.44,
    "text": "And release."
  },
  {
    "start": 103.44,
    "end": 109.44,
    "text": "Let your breath settle into its own rhythm now."
  },
  {
    "start": 109.44,
    "end": 116.88,
    "text": "Let it be natural."
  },
  {
    "start": 116.88,
    "end": 132.32,
    "text": "Let it be enough."
  },
  {
    "start": 132.32,
    "end": 138.32,
    "text": "Now, bring your awareness to the weight of your body."
  },
  {
    "start": 138.32,
    "end": 157.76,
    "text": "Notice how it rests into the bed."
  },
  {
    "start": 157.76,
    "end": 169.2,
    "text": "How the mattress gives way."
  },
  {
    "start": 169.2,
    "end": 180.64,
    "text": "You are resting with the earth tonight."
  },
  {
    "start": 180.64,
    "end": 182.64,
    "text": "Not on top of it."
  },
  {
    "start": 182.64,
    "end": 186.08,
    "text": "Not above it."
  },
  {
    "start": 186.08,
    "end": 190.08,
    "text": "With it."
  },
  {
    "start": 190.08,
    "end": 194.08,
    "text": "Bring attention to your feet."
  },
  {
    "start": 194.08,
    "end": 202.08,
    "text": "Let the weight move through your heels."
  },
  {
    "start": 202.08,
    "end": 213.52,
    "text": "Into the floor."
  },
  {
    "start": 213.52,
    "end": 217.52,
    "text": "Into the ground below."
  },
  {
    "start": 217.52,
    "end": 218.96,
    "text": "Out above it."
  },
  {
    "start": 218.96,
    "end": 220.96,
    "text": "Now feel your legs."
  },
  {
    "start": 224.96,
    "end": 226.96,
    "text": "The shins."
  },
  {
    "start": 226.96,
    "end": 230.96,
    "text": "Calves."
  },
  {
    "start": 230.96,
    "end": 232.96,
    "text": "Knees."
  },
  {
    "start": 232.96,
    "end": 234.96,
    "text": "Thighs."
  },
  {
    "start": 234.96,
    "end": 250.4,
    "text": "Let them all release downward."
  },
  {
    "start": 250.4,
    "end": 253.44,
    "text": "Feel your hips and lower torso settle."
  },
  {
    "start": 259.52,
    "end": 262.16,
    "text": "The space around your abdomen and back."
  },
  {
    "start": 262.16,
    "end": 277.2,
    "text": "Let it all drop a little deeper."
  },
  {
    "start": 277.2,
    "end": 280.96,
    "text": "Trust the earth to support you."
  },
  {
    "start": 285.2,
    "end": 287.84,
    "text": "Bring awareness to the center of your chest."
  },
  {
    "start": 292.16,
    "end": 296.72,
    "text": "Feel the breath moving through."
  },
  {
    "start": 299.68,
    "end": 300.24,
    "text": "Quiet."
  },
  {
    "start": 302.56,
    "end": 302.96,
    "text": "Even."
  },
  {
    "start": 305.52,
    "end": 306.32,
    "text": "Unforced."
  },
  {
    "start": 312.88,
    "end": 314.32,
    "text": "With every exhale."
  },
  {
    "start": 315.92,
    "end": 320.08,
    "text": "Feel yourself sink more fully into the surface beneath you."
  },
  {
    "start": 320.16,
    "end": 333.04,
    "text": "Let your shoulders rest."
  },
  {
    "start": 339.84,
    "end": 340.72,
    "text": "Your arms."
  },
  {
    "start": 340.72,
    "end": 343.28,
    "text": "Your hands."
  },
  {
    "start": 349.84,
    "end": 351.44,
    "text": "Let your jaw unhold."
  },
  {
    "start": 356.8,
    "end": 358.0,
    "text": "Your eyes soften."
  },
  {
    "start": 363.44,
    "end": 364.56,
    "text": "Your forehead smooth."
  },
  {
    "start": 364.56,
    "end": 376.16,
    "text": "Now imagine that the earth is breathing with you."
  },
  {
    "start": 376.16,
    "end": 385.12,
    "text": "A slow, steady rhythm."
  },
  {
    "start": 394.24,
    "end": 395.28,
    "text": "As you exhale."
  },
  {
    "start": 395.28,
    "end": 398.0,
    "text": "It receives."
  },
  {
    "start": 398.0,
    "end": 400.72,
    "text": "As you inhale."
  },
  {
    "start": 404.64,
    "end": 405.2,
    "text": "It gives."
  },
  {
    "start": 413.6,
    "end": 415.52,
    "text": "This support is always here."
  },
  {
    "start": 423.28,
    "end": 424.0,
    "text": "Even when the day is full."
  },
  {
    "start": 432.96,
    "end": 441.12,
    "text": "Right now, it's enough to feel the weight of your own body and the steadiness beneath it."
  },
  {
    "start": 441.12,
    "end": 455.44,
    "text": "If you'd like, repeat these words in your mind."
  },
  {
    "start": 459.6,
    "end": 462.56,
    "text": "I am supported by the ground beneath me."
  },
  {
    "start": 468.64,
    "end": 469.68,
    "text": "I can let go."
  },
  {
    "start": 475.52,
    "end": 477.04,
    "text": "It's safe to rest."
  },
  {
    "start": 482.88,
    "end": 484.8,
    "text": "There is no right way to feel."
  },
  {
    "start": 490.96,
    "end": 492.16,
    "text": "No goal to reach."
  },
  {
    "start": 498.56,
    "end": 499.76,
    "text": "Only this moment."
  },
  {
    "start": 500.96,
    "end": 502.0,
    "text": "Only this breath."
  },
  {
    "start": 510.88,
    "end": 512.64,
    "text": "Only this quiet return."
  },
  {
    "start": 522.4,
    "end": 535.6,
    "text": "Let yourself rest deeper."
  },
  {
    "start": 537.68,
    "end": 539.68,
    "text": "Feel the support beneath you."
  },
  {
    "start": 547.76,
    "end": 548.32,
    "text": "And sleep."
  }
]
