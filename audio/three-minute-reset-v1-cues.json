[
  {
    "start": 0.0,
    "end": 4.16,
    "text": "Welcome."
  },
  {
    "start": 4.16,
    "end": 14.12,
    "text": "Three minutes, that's all we need."
  },
  {
    "start": 14.12,
    "end": 18.8,
    "text": "Let your eyes close."
  },
  {
    "start": 18.8,
    "end": 25.84,
    "text": "Take a slow breath in, and a long, easy release."
  },
  {
    "start": 25.84,
    "end": 41.26,
    "text": "Again, a full breath in, and a slow exhale, letting your shoulders drop."
  },
  {
    "start": 41.26,
    "end": 52.3,
    "text": "One more, drawing the breath all the way in, and releasing everything you can on the way"
  },
  {
    "start": 52.3,
    "end": 56.34,
    "text": "out."
  },
  {
    "start": 56.34,
    "end": 63.2,
    "text": "Feel the weight of your body where it meets the surface beneath you."
  },
  {
    "start": 63.2,
    "end": 68.46,
    "text": "The shape of your hands resting."
  },
  {
    "start": 68.46,
    "end": 72.5,
    "text": "The softness in your jaw."
  },
  {
    "start": 72.5,
    "end": 82.32,
    "text": "The breath moving in and out on its own."
  },
  {
    "start": 82.32,
    "end": 86.54,
    "text": "This is your nervous system settling."
  },
  {
    "start": 86.54,
    "end": 90.58,
    "text": "All you need to do is rest here."
  },
  {
    "start": 90.58,
    "end": 100.16,
    "text": "Notice what is already true."
  },
  {
    "start": 100.16,
    "end": 104.48,
    "text": "You are safe."
  },
  {
    "start": 104.48,
    "end": 108.86,
    "text": "You are breathing."
  },
  {
    "start": 108.86,
    "end": 112.94,
    "text": "You are held."
  },
  {
    "start": 112.94,
    "end": 118.42,
    "text": "Nothing is missing in this moment."
  },
  {
    "start": 118.42,
    "end": 121.04,
    "text": "This breath is enough."
  },
  {
    "start": 121.04,
    "end": 129.18,
    "text": "Breathing in, receiving."
  },
  {
    "start": 129.18,
    "end": 132.46,
    "text": "Breathing out, letting go."
  },
  {
    "start": 132.46,
    "end": 143.5,
    "text": "a full breath in."
  },
  {
    "start": 143.5,
    "end": 145.66,
    "text": "A full breath in, and a slow release."
  },
  {
    "start": 145.66,
    "end": 150.5,
    "text": "Right here, as you are."
  },
  {
    "start": 150.5,
    "end": 154.54,
    "text": "Slowly now, begin to come back."
  },
  {
    "start": 154.54,
    "end": 158.54,
    "text": "Now, begin to come back."
  },
  {
    "start": 158.54,
    "end": 162.28,
    "text": "Feel the room around you."
  },
  {
    "start": 162.28,
    "end": 168.54,
    "text": "Wiggle your fingers, your toes."
  },
  {
    "start": 168.54,
    "end": 180.42,
    "text": "Take a full breath in, and a slow release."
  },
  {
    "start": 180.42,
    "end": 180.76,
    "text": "When you are ready, let your eyes open."
  }
]
