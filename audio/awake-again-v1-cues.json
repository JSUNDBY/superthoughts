[
  {
    "start": 16.0,
    "end": 16.634,
    "text": "Welcome."
  },
  {
    "start": 20.0,
    "end": 22.786,
    "text": "You're awake. That's all right."
  },
  {
    "start": 40.0,
    "end": 42.647,
    "text": "You don't have to get back to sleep right now."
  },
  {
    "start": 64.0,
    "end": 65.95,
    "text": "Notice the bed holding you."
  },
  {
    "start": 86.0,
    "end": 89.641,
    "text": "The weight of the covers. The cool of the pillow."
  },
  {
    "start": 114.0,
    "end": 116.59,
    "text": "Your breathing can find its own pace."
  },
  {
    "start": 148.0,
    "end": 154.455,
    "text": "If your mind is busy, let it be busy. You don't have to follow it."
  },
  {
    "start": 190.0,
    "end": 192.879,
    "text": "Feel the soft space around your face."
  },
  {
    "start": 212.0,
    "end": 213.765,
    "text": "And around your shoulders."
  },
  {
    "start": 248.0,
    "end": 250.09,
    "text": "Nothing needs to happen next."
  },
  {
    "start": 284.0,
    "end": 286.833,
    "text": "Let the music hold this quiet for a while."
  },
  {
    "start": 362.0,
    "end": 364.833,
    "text": "Whatever comes, you can rest here in the dark."
  },
  {
    "start": 392.0,
    "end": 393.997,
    "text": "Let the night take its time."
  }
]
