  },
  {
    "start": 30.0,
    "end": 40.28,
    "text": "let your jaw soften"
  },
  {
    "start": 40.28,
    "end": 47.72,
    "text": "and let your breath arrive naturally"
  },
  {
    "start": 47.72,
    "end": 54.9,
    "text": "take a slow inhale"
  },
  {
    "start": 54.9,
    "end": 61.9,
    "text": "and exhale gently"
  },
  {
    "start": 61.9,
    "end": 63.86,
    "text": "again"
  },
  {
    "start": 63.86,
    "end": 71.18,
