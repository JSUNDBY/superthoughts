  },
  {
    "start": 156.18,
    "end": 163.18,
    "text": "flowing all the way down to your feet"
  },
  {
    "start": 163.18,
    "end": 170.18,
    "text": "now imagine a clear space opening in your mind"
  },
  {
    "start": 170.18,
    "end": 178.18,
    "text": "like a window opening to fresh air"
  },
  {
    "start": 178.18,
    "end": 191.18,
    "text": "each inhale brings clarity"
  },
  {
    "start": 191.18,
    "end": 197.18,
    "text": "each exhale clears the clutter"
  },
  {
    "start": 197.18,
    "end": 204.18,
    "text": "breathing in calm"
  },
  {
    "start": 204.18,
    "end": 211.18,
    "text": "breathing out release"
  },
  {
    "start": 211.18,
    "end": 218.18,
    "text": "silently repeat"
  },
  {
    "start": 218.18,
    "end": 220.18,
    "text": "I reset"
  },
  {
    "start": 220.18,
    "end": 224.18,
    "text": "I return"
  },
  {
    "start": 224.18,
    "end": 229.18,
    "text": "I am steady"
  },
  {
    "start": 229.18,
    "end": 236.18,
    "text": "once more"
  },
  {
    "start": 252.18,
    "end": 253.18,
    "text": "take one final deep breath in"
  },
  {
    "start": 258.18,
    "end": 263.18,
    "text": "exhale fully"
  },
  {
    "start": 263.18,
    "end": 265.18,
    "text": "and when you're ready"
  },
  {
    "start": 265.18,
    "end": 270.18,
    "text": "gently open your eyes"
  },
  {
    "start": 270.18,
    "end": 278.18,
