  },
  {
    "start": 109.18,
    "end": 119.18,
    "text": "you can allow yourself to be carried"
  },
  {
    "start": 119.18,
    "end": 123.18,
    "text": "with each breath"
  },
  {
    "start": 123.18,
    "end": 130.18,
    "text": "notice tension leaving your body"
  },
  {
    "start": 130.18,
    "end": 138.18,
    "text": "softening your face"
  },
  {
    "start": 138.18,
    "end": 145.18,
    "text": "releasing your shoulders"
  },
  {
    "start": 145.18,
    "end": 156.18,
