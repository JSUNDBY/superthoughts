// superthoughts.com on Workers static assets (D81, 2026-11-23). Files match first and never run the script;
// index.js only resolves folder and extensionless addresses the way GitHub Pages did.
// Launched 2026-11-24 (Josh): superthoughts.com and www are custom domains here; GitHub Pages is off.
{
  "name": "superthoughts-site",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // Preview for invited listeners before launch (Josh 2026-11-24). Same site as members.superthoughts.com, so member sign-in works here.
  "routes": [
    { "pattern": "superthoughts.com", "custom_domain": true },
    { "pattern": "www.superthoughts.com", "custom_domain": true },
    { "pattern": "preview.superthoughts.com", "custom_domain": true }
  ],
  "assets": { "directory": "../_site", "binding": "ASSETS", "html_handling": "none", "not_found_handling": "none" }
}
